# Copy to .env and change JWT_SECRET before deploying.
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
# MongoDB Atlas connection string (…/khelbro at the end names the database).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/khelbro?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
# When true the OTP is returned in the API response so you can test without an SMS gateway.
EXPOSE_OTP=true
# Fast2SMS API Key for real SMS delivery in India (get from fast2sms.com -> Dev API)
FAST2SMS_API_KEY=
ADMIN_KEY=dev-admin-key-change-me
# Dev only: raise the OTP request cap. Leave unset in production (defaults to 5).
OTP_RATE_LIMIT=200
# Per-IP caps on the password sign-in and the "which door" check. Leave unset in
# production; the per-account lockout in lib/password.js is the real control.
# PASSWORD_RATE_LIMIT=20
# CHECK_RATE_LIMIT=30

# ---- Lobby bots ----------------------------------------------------------
# House accounts that keep battles appearing on the lobby. They never touch a
# wallet, never settle, and are excluded from every admin figure.
# Set to false to switch them off entirely.
BOT_BATTLES=true
# Each battle goes up open, is taken by a second bot within five seconds, then
# runs for a few minutes. A real player who taps one inside the open window is
# told another player just joined -- and the waiting bot takes it there and then.
#
# How many bot battles to keep on the board, open ones included (default 5, max 25).
# BOT_TARGET_RUNNING=5
# The open window, before another bot accepts. The maximum is CLAMPED to 5000ms:
# these values can only narrow the five-second promise, never widen it.
# BOT_ACCEPT_MIN_MS=1500
# BOT_ACCEPT_MAX_MS=4000
# How long one stays in Running before it is removed (defaults: 3 and 8 minutes).
# BOT_LIFETIME_MIN_MS=180000
# BOT_LIFETIME_MAX_MS=480000
# Engine pass. Clamped to 5000ms so the restart sweep stays inside the promise.
# BOT_TICK_MS=2000

# Web Push. Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Offline Aadhaar eKYC: path to UIDAI's public certificate (.cer), downloaded from
# uidai.gov.in. Without it the XML signature cannot be checked and every submission
# falls back to manual review.
UIDAI_CERT_PATH=
